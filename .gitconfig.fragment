[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  dn = "!f() { show_untracked=1; positional=0; for a in \"$@\"; do case \"$a\" in --) break ;; --cached|--staged) show_untracked=0 ;; -*) ;; *..*) show_untracked=0 ;; *) positional=$((positional + 1)) ;; esac; done; [ \"$positional\" -ge 2 ] && show_untracked=0; { git diff --name-status \"$@\"; if [ \"$show_untracked\" = 1 ]; then git ls-files --others --exclude-standard | while IFS= read -r file; do printf 'U\t%s\n' \"$file\"; done; fi; echo '@@NUMSTAT@@'; git diff --numstat \"$@\"; if [ \"$show_untracked\" = 1 ]; then git ls-files --others --exclude-standard | while IFS= read -r file; do n=$(git diff --numstat --no-index -- /dev/null \"$file\" 2>/dev/null | cut -f1); printf '%s\t0\t%s\n' \"${n:-0}\" \"$file\"; done; fi; } | awk '!m && $0==\"@@NUMSTAT@@\"{m=1;next} !m{st[++n]=substr($1,1,1);next}{print st[++j] \"  \" $0}'; }; f"
  bak = "!f() { git rev-parse --git-dir >/dev/null 2>&1 || { echo 'bak: not in a git repo' >&2; exit 1; }; git rev-parse --verify HEAD >/dev/null 2>&1 || { echo 'bak: no commits to back up' >&2; exit 1; }; t=\"bak-$(date +%Y%m%d%H%M%S)-$(git log -1 --pretty=%s | tr ' ' '-' | tr -cd 'A-Za-z0-9-')\"; git tag \"$t\" && echo \"created tag $t\"; }; f"
  squash = "!f() { git rev-parse --git-dir >/dev/null 2>&1 || { echo 'squash: not in a git repo' >&2; exit 1; }; test -z \"$(git status --porcelain)\" || { echo 'squash: working tree not clean; aborting' >&2; exit 1; }; n=${1:-1}; case \"$n\" in ''|*[!0-9]*) echo 'squash: n must be a non-negative integer' >&2; exit 1;; esac; git rev-parse --verify \"HEAD~$n\" >/dev/null 2>&1 || { echo \"squash: fewer than $n parent commit(s) available\" >&2; exit 1; }; i=0; while [ \"$i\" -lt \"$n\" ]; do git reset --soft HEAD~1 && git commit --amend --no-edit || exit 1; i=$((i+1)); done; }; f"
[pull]
	ff = only

[diff]
    tool = vimdiff
[merge]
    tool = vimdiff
    ; conflictstyle = zdiff3
[mergetool "vimdiff"]
    cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED \
          -c '$wincmd w' -c 'wincmd J'

